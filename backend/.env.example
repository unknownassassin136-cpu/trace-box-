# Server
PORT=3000

# Database (Supabase PostgreSQL URL)
DATABASE_URL="postgresql://user:password@localhost:5432/tracenode?schema=public"

# MQTT Broker (A7670C will connect to this)
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_USERNAME="tracenode_device"
MQTT_PASSWORD="your_secure_mqtt_password"
MQTT_CLIENT_ID="tracenode_backend_001"
MQTT_TLS_ENABLED="false"

# Security
JWT_SECRET="your_jwt_secret_key"
